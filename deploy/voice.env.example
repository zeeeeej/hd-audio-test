VOICE_API_TOKEN=replace-with-a-long-random-token
VOICE_BASE_URL=http://127.0.0.1:18000
ASR_URL=http://127.0.0.1:18001
TTS_URL=http://127.0.0.1:18002
ASR_MODEL_PATH=/data/voice-stack/models/Qwen3-ASR-0.6B-hf
ASR_ADAPTER_PATH=
TTS_MODEL_PATH=/data/voice-stack/models/Qwen3-TTS-12Hz-0.6B-CustomVoice
TTS_DTYPE=float32
DEFAULT_HOTWORDS=[]
MAX_UPLOAD_BYTES=20971520
MAX_AUDIO_SECONDS=60
MAX_HOTWORDS=100
MAX_HOTWORD_LENGTH=40
MAX_TTS_CHARS=500
TTS_STREAM_MAX_SENTENCE_CHARS=60
MAX_QUEUED_REQUESTS=2
VOICE_TIMEOUT_SECONDS=120
WORKER_TIMEOUT_SECONDS=120
# Business service only. Keep secrets out of version control.
# An empty DEEPSEEK_API_KEY falls back to DEEPSEEK_KEY_FILE or the project-root .key.
DEEPSEEK_API_KEY=
# DEEPSEEK_KEY_FILE=/data/voice-stack/config/deepseek.key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=20
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=256
# Writable persistent catalog; seed this file once before enabling.
# Unset: initialize runtime/retail_catalog.json from the bundled demo catalog.
# RETAIL_CATALOG_FILE=/data/voice-stack/config/retail_catalog.json
DIALOGUE_MAX_TURNS=6
DIALOGUE_HISTORY_TURNS=3
DIALOGUE_IDLE_SECONDS=60
DIALOGUE_MAX_SESSIONS=100
DIALOGUE_MAX_INPUT_CHARS=500
DIALOGUE_CONTEXT_CHARS=6000
DIALOGUE_REPLY_CHARS=60
DIALOGUE_SENTENCE_CHARS=30
# Soft first-sentence target; necessary product names may exceed it, up to the hard limit above.
DIALOGUE_FIRST_SENTENCE_TARGET_CHARS=12
DIALOGUE_REPLY_SENTENCES=2
TMPDIR=/data/voice-stack/runtime/tmp
HF_HOME=/data/voice-stack/model-cache
MODELSCOPE_CACHE=/data/voice-stack/model-cache/modelscope
FFMPEG_BIN=/data/miniconda3/envs/voice-asr/bin/ffmpeg
PYTHONUNBUFFERED=1
